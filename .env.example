# Copy to .env and fill in values. Loaded when the workflow orchestrator extension starts.
# Run `pi` from the project root so dotenv picks up .env.

# Required for OpenRouter models (see .pi/agents/*.md)
OPENROUTER_API_KEY=

# Optional: integration test harness (tests/harness/pm-memory.mjs)
# PI_TEST_MODEL=anthropic/claude-sonnet-4-5
